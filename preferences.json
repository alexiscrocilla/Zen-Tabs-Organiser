[
  {
    "type": "separator",
    "label": "Toolbar buttons"
  },
  {
    "property": "zen-tabs-organiser.enable_sort",
    "label": "Show the **Sort** button",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "zen-tabs-organiser.enable_clear",
    "label": "Show the **Clear** button — replaces the one the sidebar row already provides (Zen's, or Natsumi's) while it is on",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "Groups"
  },
  {
    "property": "zen-tabs-organiser.auto_colors",
    "label": "Auto-assign colors to groups",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "zen-tabs-organiser.auto_icons",
    "label": "Auto-assign icons to groups",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "zen-tabs-organiser.min_group_size",
    "label": "Minimum tabs per group",
    "type": "string",
    "value": "num",
    "defaultValue": 2,
    "placeholder": "2"
  },
  {
    "type": "separator",
    "label": "AI grouping"
  },
  {
    "property": "zen-tabs-organiser.ai_model",
    "label": "AI Provider",
    "type": "dropdown",
    "defaultValue": "0",
    "placeholder": false,
    "options": [
      {
        "value": "0",
        "label": "None (group by domain)"
      },
      {
        "value": "5",
        "label": "Local — Firefox AI, no API key"
      },
      {
        "value": "1",
        "label": "Gemini"
      },
      {
        "value": "2",
        "label": "Ollama"
      },
      {
        "value": "3",
        "label": "Mistral"
      },
      {
        "value": "4",
        "label": "OpenAI"
      }
    ]
  },
  {
    "property": "zen-tabs-organiser.ai_api_key",
    "label": "API Key",
    "type": "string",
    "placeholder": "Gemini, Mistral, OpenAI — not needed for Local or Ollama",
    "conditions": [
      {
        "if": {
          "property": "zen-tabs-organiser.ai_model",
          "value": "1"
        }
      },
      {
        "if": {
          "property": "zen-tabs-organiser.ai_model",
          "value": "3"
        }
      },
      {
        "if": {
          "property": "zen-tabs-organiser.ai_model",
          "value": "4"
        }
      }
    ]
  },
  {
    "property": "zen-tabs-organiser.ai_model_name",
    "label": "Model",
    "type": "string",
    "placeholder": "gpt-4o-mini, gemini-2.0-flash, llama3.2",
    "conditions": [
      {
        "if": {
          "property": "zen-tabs-organiser.ai_model",
          "value": "1"
        }
      },
      {
        "if": {
          "property": "zen-tabs-organiser.ai_model",
          "value": "2"
        }
      },
      {
        "if": {
          "property": "zen-tabs-organiser.ai_model",
          "value": "3"
        }
      },
      {
        "if": {
          "property": "zen-tabs-organiser.ai_model",
          "value": "4"
        }
      }
    ]
  },
  {
    "property": "zen-tabs-organiser.ai_endpoint",
    "label": "Endpoint",
    "type": "string",
    "placeholder": "Only for Ollama or OpenAI-compatible",
    "conditions": [
      {
        "if": {
          "property": "zen-tabs-organiser.ai_model",
          "value": "2"
        }
      },
      {
        "if": {
          "property": "zen-tabs-organiser.ai_model",
          "value": "4"
        }
      }
    ]
  }
]
